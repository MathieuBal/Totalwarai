# Copier en `.env` et adapter. Aucune de ces variables n'est obligatoire :
# elles surchargent simplement les valeurs de `config/default.yaml`.

# Fichier de configuration principal utilise par le CLI.
TOTALWAR_AI_CONFIG=config/default.yaml

# Repertoire racine des donnees (batailles, modeles, rapports, base SQLite).
TOTALWAR_AI_DATA_DIR=data

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
TOTALWAR_AI_LOG_LEVEL=INFO
